def normalize_dataset(df: pd.DataFrame) -> pd.DataFrame:
    """Validate and standardize uploaded CSV columns for the ML pipeline."""
    df = df.copy()
    df.columns = [str(c).strip() for c in df.columns]
    # Accept common variations in column names.
    rename = {}
    for col in df.columns:
        key = col.strip().lower().replace("_", " ")
        if key in {"date", "order date", "transaction date", "sales date"}:
            rename[col] = "Order Date"
        elif key in {"sales", "revenue", "amount", "total sales"}:
            rename[col] = "Sales"
        elif key in {"quantity", "qty", "units"}:
            rename[col] = "Quantity"
        elif key in {"unit price", "price", "unitprice"}:
            rename[col] = "Unit Price"
        elif key in {"category", "product category"}:
            rename[col] = "Category"
        elif key in {"region", "location", "market"}:
            rename[col] = "Region"
        elif key in {"profit", "net profit"}:
            rename[col] = "Profit"
        elif key in {"order id", "orderid", "transaction id"}:
            rename[col] = "Order ID"
        elif key in {"payment method", "payment"}:
            rename[col] = "Payment Method"
        elif key in {"day type", "daytype"}:
            rename[col] = "Day Type"
    df = df.rename(columns=rename)
    required = {"Order Date", "Sales", "Quantity"}
    missing = sorted(required - set(df.columns))
    if missing:
        raise ValueError("CSV is missing required column(s): " + ", ".join(missing))

    df["Order Date"] = pd.to_datetime(df["Order Date"], dayfirst=True, errors="coerce")
    for col in ["Sales", "Quantity"]:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    if "Unit Price" not in df:
        df["Unit Price"] = np.where(df["Quantity"].fillna(0) != 0,
                                    df["Sales"] / df["Quantity"].replace(0, np.nan), 0)
    else:
        df["Unit Price"] = pd.to_numeric(df["Unit Price"], errors="coerce")
    if "Profit" not in df:
        df["Profit"] = 0.0
    else:
        df["Profit"] = pd.to_numeric(df["Profit"], errors="coerce").fillna(0)
    for col, default in [("Category", "Uncategorized"), ("Region", "Unknown"),
                         ("Payment Method", "Unknown"), ("Day Type", "Unknown")]:
        if col not in df:
            df[col] = default
        df[col] = df[col].fillna(default).astype(str)
    if "Order ID" not in df:
        df["Order ID"] = [f"ROW-{i + 1:06d}" for i in range(len(df))]
    df = df.dropna(subset=["Order Date", "Sales", "Quantity"]).copy()
    df = df.drop_duplicates().sort_values("Order Date").reset_index(drop=True)
    if df.empty:
        raise ValueError("The CSV contains no valid rows after cleaning.")
    return df


@st.cache_resource(show_spinner="Training forecasting models on the sales data…")
def load_service(data_path: str, modified_at: float):
    # modified_at is part of the cache key so a newly uploaded dataset retrains.
    import sys
    if str(PROJECT_DIR) not in sys.path:
        sys.path.insert(0, str(PROJECT_DIR))
    from ml_service import MLService
    service = MLService(data_path=data_path)
    if service.raw_df is None or service.raw_df.empty or not service.is_trained:
        raise RuntimeError("The model service could not load/train on this dataset.")
    return service


