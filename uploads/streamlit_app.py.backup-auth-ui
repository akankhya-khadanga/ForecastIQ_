def apply_dashboard_theme(fig):
    """Apply the same near-black surfaces and green accent as templates/index.html."""
    fig.update_layout(
        template="plotly_dark",
        paper_bgcolor="#101617",
        plot_bgcolor="#101617",
        font=dict(family="Inter, sans-serif", color="#dce7e1", size=12),
        title_font=dict(family="Inter, sans-serif", color="#f3f7f5", size=16),
        margin=dict(l=12, r=12, t=54, b=12),
        legend_title_text="",
        colorway=["#22c55e", "#00e676", "#84cc16", "#38bdf8", "#f59e0b", "#a78bfa", "#fb7185"],
        hoverlabel=dict(bgcolor="#0d1213", bordercolor="#22c55e", font_color="#f3f7f5"),
    )
    fig.update_xaxes(showgrid=False, zeroline=False, linecolor="#263230", tickfont_color="#a0aca7")
    fig.update_yaxes(showgrid=True, gridcolor="#263230", zeroline=False, linecolor="#263230", tickfont_color="#a0aca7")
    return fig


def make_line_chart(df: pd.DataFrame, x: str, y: str, title: str,
                    color: Optional[str] = None, markers: bool = False):
    fig = px.line(df, x=x, y=y, color=color, markers=markers, title=title,
                  template="plotly_dark", color_discrete_sequence=["#22c55e", "#00e676", "#f59e0b", "#38bdf8"])
    apply_dashboard_theme(fig)
    fig.update_layout(hovermode="x unified")
    fig.update_yaxes(tickprefix="₹", tickformat=",.0f")
    return fig


