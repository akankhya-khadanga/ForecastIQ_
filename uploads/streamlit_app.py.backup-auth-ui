def _firebase_settings():
    try:
        api_key = str(st.secrets["firebase"]["api_key"]).strip()

        if not api_key or "YOUR_" in api_key:
            return None

        return api_key

    except Exception:
        return None


def _activate_session(auth_payload: dict, display_name: str = ""):
    from firebase_db import get_firestore_client, save_user_profile
    from firebase_admin import auth as firebase_admin_auth

    # Initializing the Admin SDK also validates the service-account configuration.
    get_firestore_client()
    decoded = firebase_admin_auth.verify_id_token(auth_payload["idToken"])
    uid = decoded["uid"]
    email = decoded.get("email", auth_payload.get("email", ""))
    save_user_profile(uid, email, display_name)
    st.session_state["forecastiq_auth"] = {
        "uid": uid,
        "email": email,
        "display_name": display_name,
        "id_token": auth_payload["idToken"],
        "refresh_token": auth_payload.get("refreshToken", ""),
    }


def _ensure_authenticated(api_key: str) -> bool:
    from firebase_db import get_firestore_client
    from firebase_admin import auth as firebase_admin_auth
    from firebase_auth import refresh_session, FirebaseAuthError

    session = st.session_state.get("forecastiq_auth")
    if not session:
        return False
    try:
        get_firestore_client()
        firebase_admin_auth.verify_id_token(session["id_token"])
        return True
    except firebase_admin_auth.ExpiredIdTokenError:
        try:
            refreshed = refresh_session(api_key, session.get("refresh_token", ""))
            firebase_admin_auth.verify_id_token(refreshed["id_token"])
            session["id_token"] = refreshed["id_token"]
            session["refresh_token"] = refreshed.get("refresh_token", session.get("refresh_token", ""))
            st.session_state["forecastiq_auth"] = session
            return True
        except Exception:
            st.session_state.pop("forecastiq_auth", None)
            return False
    except Exception:
        st.session_state.pop("forecastiq_auth", None)
        return False


