        model_label = st.selectbox("Forecast model", list(model_options.keys()), index=0)
        horizon = st.slider("Forecast horizon (days)", min_value=7, max_value=183, value=183, step=7)
        st.caption("Default view covers roughly six months. Forecasts use the complete dataset and are independent of overview filters.")
    forecast_rows = service.get_forecast_data(model_key=model_options[model_label], future_days=horizon)
    forecast_df = pd.DataFrame(forecast_rows)
    forecast_df["date"] = pd.to_datetime(forecast_df["date"])
    hist_plot = forecast_df[forecast_df["actual"].notna()].tail(180)
    future_plot = forecast_df[forecast_df["actual"].isna()].copy()
    with fc2:
        fig = go.Figure()
        fig.add_trace(go.Scatter(x=hist_plot["date"], y=hist_plot["actual"], name="Actual sales", mode="lines", line=dict(color="#2563eb", width=2)))
        # Connect forecast line from the last actual date for a continuous transition.
        if not hist_plot.empty and not future_plot.empty:
            boundary = pd.DataFrame({"date": [hist_plot["date"].iloc[-1]], "forecast": [hist_plot["actual"].iloc[-1]]})
            future_line = pd.concat([boundary, future_plot[["date", "forecast"]]], ignore_index=True)
        else:
            future_line = future_plot[["date", "forecast"]]
        fig.add_trace(go.Scatter(x=future_line["date"], y=future_line["forecast"], name="Forecast", mode="lines", line=dict(color="#f97316", width=2.5, dash="dash")))
        if not future_plot.empty:
            fig.add_trace(go.Scatter(x=pd.concat([future_plot["date"], future_plot["date"][::-1]]),
                                     y=pd.concat([future_plot["upper"], future_plot["lower"][::-1]]),
                                     fill="toself", fillcolor="rgba(249,115,22,0.14)", line=dict(color="rgba(0,0,0,0)"),
                                     name="Forecast interval", hoverinfo="skip"))
        fig.update_layout(title=f"Actual vs {model_label} forecast", template="plotly_dark", margin=dict(l=10, r=10, t=55, b=10), hovermode="x unified", legend_title_text="")
        fig.update_yaxes(tickprefix="₹", tickformat=",.0f", gridcolor="#263230")
        apply_dashboard_theme(fig)
        st.plotly_chart(fig, use_container_width=True)
    if not future_plot.empty:
        a, b, c = st.columns(3)
        a.metric("Forecast total", money(float(future_plot["forecast"].sum())))
        b.metric("Daily forecast average", money(float(future_plot["forecast"].mean())))
        c.metric("Forecast end date", future_plot["date"].max().strftime("%d %b %Y"))
        st.download_button("Download forecast CSV", future_plot.to_csv(index=False).encode("utf-8"), file_name="forecastiq_forecast.csv", mime="text/csv")
        if st.button("Save forecast to my account", type="primary"):
